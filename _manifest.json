{
  "manifest_version": 2,
  "id": "github.yunshanluan0714.zzz-wiki",
  "version": "0.1.0",
  "plugin_type": "tool",
  "name": "绝区零维基",
  "description": "查询绝区零（Zenless Zone Zero）中文维基（B站维基）的角色属性、天赋、配装推荐、阵容搭配，以及驱动盘、音擎、怪物等词条，支持可选本地离线语料加速。",
  "author": {
    "name": "yunshanluan0714",
    "url": "https://github.com/yunshanluan0714"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/yunshanluan0714/maibot-zzz-wiki",
    "homepage": "https://github.com/yunshanluan0714/maibot-zzz-wiki",
    "documentation": "https://github.com/yunshanluan0714/maibot-zzz-wiki/blob/main/README.md",
    "issues": "https://github.com/yunshanluan0714/maibot-zzz-wiki/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.20.0",
    "max_version": "2.30.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
